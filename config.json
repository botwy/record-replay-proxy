{
  "target": "https://test.example.com",
  "port": 3001,
  "tls": {
    "rejectUnauthorized": false
  },
  "record": {
    "include": [
      "/api/**"
    ],
    "exclude": [
      "/api/health",
      "/api/metrics"
    ],
    "contentTypes": [
      "application/json",
      "application/problem+json"
    ]
  }
}