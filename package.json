{
  "name": "record-replay-proxy",
  "version": "0.1.0",
  "description": "REST and WebSocket record/replay proxy for manual frontend testing",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --experimental-strip-types proxy.ts replay",
    "record": "node --experimental-strip-types proxy.ts record",
    "replay": "node --experimental-strip-types proxy.ts replay",
    "rest:list": "node --experimental-strip-types proxy.ts rest:list",
    "ws:list": "node --experimental-strip-types proxy.ts ws:list",
    "ws:send": "node --experimental-strip-types proxy.ts ws:send"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^4.2.0",
    "picomatch": "^4.0.2",
    "typescript": "^7.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1"
  }
}
